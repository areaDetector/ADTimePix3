# IXS / dual-threshold band-pass: T0 - T1 (between-threshold counts).
# Used with NDPluginProcess (background = high-threshold image, input = low-threshold).
# See init_ixs_thresh_diff.cmd and documentation/medipix3/integration.md.
#
# Serval delivery order per trigger: thresholdID=1 (T1) then thresholdID=0 (T0).
# Run SaveTh1BgSeq / SaveIntTh1BgSeq when the matching T1 / integrated-T1 array is current
# (e.g. on imageTh1:ArrayCounter_RBV change), before the paired T0 frame is processed.

# --- Frame band: capture T1 from imageTh1 into procFrameDiff background ---
record(sseq, "$(P)procFrameDiff:SaveTh1BgSeq")
{
    field(DESC, "Store imageTh1 as procFrameDiff background (T1 for T0-T1)")
    field(DOL1, "$(P)procFrameDiff:NDArrayPort")
    field(LNK1, "$(P)procFrameDiff:PortBackup PP MS")
    field(DOL2, "ImageTh1")
    field(LNK2, "$(P)procFrameDiff:NDArrayPort PP MS")
    field(DLY3, "0.05")
    field(DO3, "1")
    field(LNK3, "$(P)procFrameDiff:SaveBackground PP MS")
    field(DOL4, "$(P)procFrameDiff:PortBackup")
    field(LNK4, "$(P)procFrameDiff:NDArrayPort PP MS")
}

# --- Integrated band: capture imageIntTh1 into procIntDiff background ---
record(sseq, "$(P)procIntDiff:SaveIntTh1BgSeq")
{
    field(DESC, "Store imageIntTh1 as procIntDiff background")
    field(DOL1, "$(P)procIntDiff:NDArrayPort")
    field(LNK1, "$(P)procIntDiff:PortBackup PP MS")
    field(DOL2, "ImageIntTh1")
    field(LNK2, "$(P)procIntDiff:NDArrayPort PP MS")
    field(DLY3, "0.05")
    field(DO3, "1")
    field(LNK3, "$(P)procIntDiff:SaveBackground PP MS")
    field(DOL4, "$(P)procIntDiff:PortBackup")
    field(LNK4, "$(P)procIntDiff:NDArrayPort PP MS")
}

record(stringout, "$(P)procFrameDiff:PortBackup") { }
record(stringout, "$(P)procIntDiff:PortBackup") { }

# Fire SaveTh1BgSeq when imageTh1 counter steps (T1 arrived on std-array port).
record(calc, "$(P)ixsFrmTh1BgTrig")
{
    field(DESC, "Pulse SaveTh1Bg when imageTh1 ArrayCounter changes")
    field(SCAN, "1 second")
    field(INPA, "$(P)imageTh1:ArrayCounter_RBV CP MS")
    field(INPB, "$(P)ixsFrmTh1BgTrig.LAST NPP NMS")
    field(CALC, "A!=B")
    field(FLNK, "$(P)procFrameDiff:SaveTh1BgSeq.PROC")
}
record(longout, "$(P)ixsFrmTh1BgTrig.LAST")
{
    field(INP, "$(P)imageTh1:ArrayCounter_RBV CP")
}

record(calc, "$(P)ixsIntTh1BgTrig")
{
    field(DESC, "Pulse SaveIntTh1Bg when imageIntTh1 ArrayCounter changes")
    field(SCAN, "1 second")
    field(INPA, "$(P)imageIntTh1:ArrayCounter_RBV CP MS")
    field(INPB, "$(P)ixsIntTh1BgTrig.LAST NPP NMS")
    field(CALC, "A!=B")
    field(FLNK, "$(P)procIntDiff:SaveIntTh1BgSeq.PROC")
}
record(longout, "$(P)ixsIntTh1BgTrig.LAST")
{
    field(INP, "$(P)imageIntTh1:ArrayCounter_RBV CP")
}
