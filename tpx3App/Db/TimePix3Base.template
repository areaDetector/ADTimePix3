include "ADBase.template"

###############################################################################
#  Note: Records below override ADBase.template. Some set DB enum fields;      #
#        TriggerMode uses driver readEnum() instead (see ADTimePix.cpp).      #
###############################################################################

###############################################################################
#  TriggerMode (mbbo/mbbi from ADBase.template)                               #
#  Enum menu strings from driver readEnum() — ADTimePix.cpp kTriggerModes[].  #
#  No ZRST/ONST/... here; asyn devAsynInt32 fills choices at runtime.         #
#  Index 7: menu SwReSt_SwReSp; Serval SOFTWARESTART_SOFTWARESTOP (26-char).  #
###############################################################################

record(mbbo, "$(P)$(R)TriggerMode")
{
   field(DESC, "Serval TriggerMode")
}

record(mbbi, "$(P)$(R)TriggerMode_RBV")
{
   field(DESC, "Serval TriggerMode RBV")
}


###################################################################
#  These records control the data type                            # 
###################################################################

record(mbbo, "$(P)$(R)DataType")
{
   field(PINI, "YES")
   field(DTYP, "asynInt32")
   field(OUT,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))DATA_TYPE")
   field(ZRVL, "0")
   field(ZRST, "UInt8")
   field(ONVL, "1")
   field(ONST, "Int8")
   field(TWVL, "2")
   field(TWST, "UInt16")
   field(THVL, "3")
   field(THST, "Int16")
   field(FRVL, "4")
   field(FRST, "UInt32")
   field(FVVL, "5")
   field(FVST, "Int32")
   field(SXST, "")
   field(SXVL, "")
   field(SVST, "")
   field(SVVL, "")
   field(EIST, "")
   field(EIVL, "")
   field(NIST, "")
   field(NIVL, "")
   field(VAL,  "2")
   info(autosaveFields, "VAL")
}

record(mbbi, "$(P)$(R)DataType_RBV")
{
   field(DTYP, "asynInt32")
   field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))DATA_TYPE")
   field(ZRVL, "0")
   field(ZRST, "UInt8")
   field(ONVL, "1")
   field(ONST, "Int8")
   field(TWVL, "2")
   field(TWST, "UInt16")
   field(THVL, "3")
   field(THST, "Int16")
   field(FRVL, "4")
   field(FRST, "UInt32")
   field(FVVL, "5")
   field(FVST, "Int32")
   field(SXST, "")
   field(SXVL, "")
   field(SVST, "")
   field(SVVL, "")
   field(EIST, "")
   field(EIVL, "")
   field(NIST, "")
   field(NIVL, "")
   field(SCAN, "I/O Intr")
}

