  <widget type="group" version="3.0.0">
    <name>ActionsGroup</name>
    <x>5</x>
    <y>450</y>
    <width>330</width>
    <height>65</height>
    <widget type="label" version="2.0.0">
      <name>ActionsTitle</name>
      <text>Related</text>
      <x>5</x>
      <y>2</y>
      <width>120</width>
      <background_color>
        <color red="240" green="240" blue="240">
        </color>
      </background_color>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>DetectorHealthBtn</name>
      <actions>
        <action type="open_display">
          <description>Detector health</description>
          <file>TimePixDetectorHealth.bob</file>
          <target>tab</target>
        </action>
      </actions>
      <text>Detector health</text>
      <x>80</x>
      <y>5</y>
      <width>120</width>
      <height>26</height>
      <background_color>
        <color red="115" green="223" blue="255">
        </color>
      </background_color>
      <tooltip>Open detector health summary</tooltip>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>RefreshBtn</name>
      <actions>
        <action type="write_pv">
          <description>Refresh health from Serval</description>
          <pv_name>$(P)$(R)Health</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>Refresh</text>
      <x>220</x>
      <y>5</y>
      <width>75</width>
      <height>26</height>
      <background_color>
        <color red="115" green="223" blue="255">
        </color>
      </background_color>
      <tooltip>Pulse Health=1 to read back power rails from Serval</tooltip>
    </widget>
  </widget>
