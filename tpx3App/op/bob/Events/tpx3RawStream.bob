        </rule>
      </rules>
    </widget>
    <widget type="label" version="2.0.0">
      <name>ImgHint</name>
      <text>Raster follows Map. Sum ToT ≈ jsonimage. ToT band + Chip filter; reset after map/kind/band/chip change.</text>
