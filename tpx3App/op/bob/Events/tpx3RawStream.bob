<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>tpx3RawStream</name>
  <macros>
    <P>$(P=TPX3:)</P>
    <R>$(R=raw:)</R>
  </macros>
  <width>1280</width>
  <height>1430</height>
  <widget type="group" version="3.0.0">
    <name>root</name>
    <width>1280</width>
    <height>1430</height>
    <widget type="label" version="2.0.0">
      <name>Title</name>
      <text>TPX3 raw TCP stream (tpx3events)</text>
      <x>20</x>
      <y>10</y>
      <width>1240</width>
      <height>28</height>
      <font>
        <font family="Sans" style="BOLD" size="18.0">
        </font>
      </font>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Hint</name>
      <text>PV prefix $(P)$(R) — override P/R at open (e.g. P=MYBL: R=raw:); defaults match st.cmd Sys/Dev. Asyn port TPX3_RAW is IOC-only.</text>
      <x>20</x>
      <y>38</y>
      <width>600</width>
      <height>22</height>
      <font>
        <font family="Sans" style="REGULAR" size="11.0">
        </font>
      </font>
      <foreground_color>
        <color red="90" green="90" blue="90">
        </color>
      </foreground_color>
    </widget>
    <widget type="rectangle" version="2.0.0">
      <name>LeftPanelFrame</name>
      <x>2</x>
      <y>5</y>
      <width>655</width>
      <height>1300</height>
      <line_width>1</line_width>
      <transparent>true</transparent>
    </widget>
    <widget type="rectangle" version="2.0.0">
      <name>ChipHitsPanelFrame</name>
      <x>12</x>
      <y>1003</y>
      <width>638</width>
      <height>88</height>
      <line_width>1</line_width>
      <transparent>true</transparent>
    </widget>
    <widget type="rectangle" version="2.0.0">
      <name>TimingPanelFrame</name>
      <x>12</x>
      <y>1098</y>
      <width>638</width>
      <height>200</height>
      <line_width>1</line_width>
      <transparent>true</transparent>
    </widget>
    <widget type="rectangle" version="2.0.0">
      <name>ImgPanelFrame</name>
      <x>665</x>
      <y>5</y>
      <width>560</width>
      <height>708</height>
      <line_width>1</line_width>
      <transparent>true</transparent>
    </widget>
    <widget type="label" version="2.0.0">
      <name>ImgHdr512</name>
      <text>Hit image (512×512)</text>
      <x>680</x>
      <y>11</y>
      <width>500</width>
      <height>22</height>
      <visible>false</visible>
      <font>
        <font family="Sans" style="BOLD" size="12.0">
        </font>
      </font>
      <rules>
        <rule name="visHdr512" prop_id="visible" out_exp="false">
          <exp bool_exp="pv0==0">
            <value>true</value>
          </exp>
          <pv_name>$(P)$(R)ImgMapMode</pv_name>
        </rule>
      </rules>
    </widget>
    <widget type="label" version="2.0.0">
      <name>ImgHdr256</name>
