<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Mpx3HdfImgConfig</name>
  <width>1125</width>
  <height>620</height>
  <background_color>
    <color red="187" green="187" blue="187">
    </color>
  </background_color>
  <grid_step_x>5</grid_step_x>
  <grid_step_y>5</grid_step_y>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>HDF5 Image[] archive — HDFImgT0 (addr 1) / HDFImgT1 (addr 13) — not HDF1</text>
    <x>5</x>
    <y>5</y>
    <width>1115</width>
    <height>28</height>
    <font>
      <font family="Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255">
      </color>
    </foreground_color>
    <background_color>
      <color red="10" green="0" blue="184">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Recipe</name>
    <text>Recipe: WriteImg=1 + WriteData → Enable plugins → Acquire once (latch dims) → Capture=1 → Acquire again. Disable Pva7/Pva8 at high Hz.</text>
    <x>5</x>
    <y>38</y>
    <width>900</width>
    <height>20</height>
    <font>
      <font family="Sans" style="REGULAR" size="10.0">
      </font>
    </font>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>ApplyDefaultsBtn</name>
    <actions>
      <action type="write_pv">
        <description>T0 path</description>
        <pv_name>$(P)HDFImgT0:FilePath</pv_name>
        <value>/tmp/mpx3_hdf/</value>
      </action>
      <action type="write_pv">
        <description>T0 name</description>
        <pv_name>$(P)HDFImgT0:FileName</pv_name>
        <value>img_t0</value>
      </action>
      <action type="write_pv">
        <description>T0 template</description>
        <pv_name>$(P)HDFImgT0:FileTemplate</pv_name>
        <value>%s%s_%3.3d.h5</value>
      </action>
      <action type="write_pv">
        <description>T0 number</description>
        <pv_name>$(P)HDFImgT0:FileNumber</pv_name>
        <value>0</value>
      </action>
      <action type="write_pv">
        <description>T0 autoinc</description>
        <pv_name>$(P)HDFImgT0:AutoIncrement</pv_name>
        <value>1</value>
      </action>
      <action type="write_pv">
        <description>T0 stream</description>
        <pv_name>$(P)HDFImgT0:FileWriteMode</pv_name>
        <value>2</value>
      </action>
      <action type="write_pv">
        <description>T0 numcap</description>
        <pv_name>$(P)HDFImgT0:NumCapture</pv_name>
        <value>100</value>
      </action>
      <action type="write_pv">
        <description>T0 enable</description>
        <pv_name>$(P)HDFImgT0:EnableCallbacks</pv_name>
        <value>1</value>
      </action>
      <action type="write_pv">
        <description>T1 path</description>
        <pv_name>$(P)HDFImgT1:FilePath</pv_name>
        <value>/tmp/mpx3_hdf/</value>
      </action>
      <action type="write_pv">
        <description>T1 name</description>
        <pv_name>$(P)HDFImgT1:FileName</pv_name>
        <value>img_t1</value>
      </action>
      <action type="write_pv">
        <description>T1 template</description>
        <pv_name>$(P)HDFImgT1:FileTemplate</pv_name>
        <value>%s%s_%3.3d.h5</value>
      </action>
      <action type="write_pv">
        <description>T1 number</description>
        <pv_name>$(P)HDFImgT1:FileNumber</pv_name>
        <value>0</value>
      </action>
      <action type="write_pv">
        <description>T1 autoinc</description>
        <pv_name>$(P)HDFImgT1:AutoIncrement</pv_name>
        <value>1</value>
      </action>
      <action type="write_pv">
        <description>T1 stream</description>
        <pv_name>$(P)HDFImgT1:FileWriteMode</pv_name>
        <value>2</value>
      </action>
      <action type="write_pv">
        <description>T1 numcap</description>
        <pv_name>$(P)HDFImgT1:NumCapture</pv_name>
        <value>100</value>
      </action>
      <action type="write_pv">
        <description>T1 enable</description>
        <pv_name>$(P)HDFImgT1:EnableCallbacks</pv_name>
        <value>1</value>
      </action>
      <action type="write_pv">
        <description>Disable Pva7</description>
        <pv_name>$(P)Pva7:EnableCallbacks</pv_name>
        <value>0</value>
      </action>
      <action type="write_pv">
        <description>Disable Pva8</description>
        <pv_name>$(P)Pva8:EnableCallbacks</pv_name>
        <value>0</value>
      </action>
    </actions>
    <text>Apply defaults</text>
    <x>910</x>
    <y>35</y>
    <width>100</width>
    <height>26</height>
    <background_color>
      <color red="115" green="223" blue="255">
      </color>
    </background_color>
    <tooltip>Same as init_detector_hdf5_img_mpx3.cmd (/tmp/mpx3_hdf/). Does not arm Capture.</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>ArmCaptureBtn</name>
    <actions>
      <action type="write_pv">
        <description>Arm T0</description>
        <pv_name>$(P)HDFImgT0:Capture</pv_name>
        <value>1</value>
      </action>
      <action type="write_pv">
        <description>Arm T1</description>
        <pv_name>$(P)HDFImgT1:Capture</pv_name>
        <value>1</value>
      </action>
    </actions>
    <text>Arm Capture</text>
    <x>1015</x>
    <y>35</y>
    <width>100</width>
    <height>26</height>
    <background_color>
      <color red="255" green="200" blue="100">
      </color>
    </background_color>
    <tooltip>After dims latched (one Acquire with Enable on). Same as init_detector_hdf5_img_mpx3_arm.cmd</tooltip>
  </widget>
