<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Mpx3ImageChannels</name>
  <width>1125</width>
  <height>470</height>
  <background_color>
    <color red="187" green="187" blue="187">
    </color>
  </background_color>
  <grid_step_x>5</grid_step_x>
  <grid_step_y>5</grid_step_y>
  <widget type="group" version="3.0.0">
    <name>ImageHeader</name>
    <width>1120</width>
    <height>70</height>
    <widget type="label" version="2.0.0">
      <name>ImgHdrLbl</name>
      <text>Full-rate Image[] (opt-in) — keep Preview On for OP; do not drive Phoebus from Image at high Hz</text>
      <x>5</x>
      <y>4</y>
      <width>900</width>
      <height>18</height>
      <font>
        <font family="Sans" style="BOLD" size="11.0">
        </font>
      </font>
      <foreground_color>
        <color red="10" green="0" blue="184">
        </color>
      </foreground_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>HttpLbl</name>
      <text>HTTP</text>
      <x>10</x>
      <y>32</y>
      <width>40</width>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>HttpCode</name>
      <pv_name>$(P)$(R)HttpCode_RBV</pv_name>
      <x>55</x>
      <y>30</y>
      <width>45</width>
      <height>22</height>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>WriteDataBtn</name>
      <actions>
        <action type="write_pv">
          <description>Push destination to Serval</description>
          <pv_name>$(P)$(R)WriteData</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>WriteData</text>
      <x>115</x>
      <y>26</y>
      <width>85</width>
      <height>26</height>
      <background_color>
        <color red="115" green="223" blue="255">
        </color>
      </background_color>
      <tooltip>Push Server.Destination (Image + Preview) to Serval</tooltip>
    </widget>
    <widget type="label" version="2.0.0">
      <name>WriteImgEnLbl</name>
      <text>WriteImg PV/SP</text>
      <x>220</x>
      <y>32</y>
      <width>95</width>
    </widget>
    <widget type="led" version="2.0.0">
      <name>WriteImgLED</name>
      <pv_name>$(P)$(R)WriteImg</pv_name>
      <x>320</x>
      <y>28</y>
      <width>18</width>
      <height>18</height>
      <tooltip>WriteImg (setpoint)</tooltip>
    </widget>
    <widget type="led" version="2.0.0">
      <name>WriteImgRBV</name>
      <pv_name>$(P)$(R)WriteImg_RBV</pv_name>
      <x>342</x>
      <y>28</y>
      <width>18</width>
      <height>18</height>
      <on_color>
        <color red="255" green="0" blue="0">
        </color>
