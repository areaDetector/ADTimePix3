      <name>WriteMsgLbl</name>
      <text>Message</text>
      <x>10</x>
      <y>48</y>
      <width>60</width>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>WriteFileMessage</name>
      <pv_name>$(P)$(R)WriteFileMessage</pv_name>
      <x>75</x>
      <y>44</y>
      <width>1010</width>
      <height>30</height>
      <font>
        <font family="Sans" style="REGULAR" size="10.0">
        </font>
      </font>
      <foreground_color>
        <color red="40" green="40" blue="40">
        </color>
      </foreground_color>
      <background_color>
        <color red="245" green="245" blue="245">
        </color>
      </background_color>
      <format>6</format>
      <vertical_alignment>1</vertical_alignment>
      <rules>
        <rule name="msg_ok" prop_id="foreground_color" out_exp="false">
          <exp bool_exp="pv0==0">
            <value>
              <color red="0" green="120" blue="0">
              </color>
            </value>
          </exp>
          <pv_name>$(P)$(R)HttpCode_RBV</pv_name>
        </rule>
        <rule name="msg_err" prop_id="foreground_color" out_exp="false">
          <exp bool_exp="pv0&gt;0 &amp;&amp; pv0!=200">
            <value>
              <color red="200" green="0" blue="0">
              </color>
            </value>
          </exp>
          <pv_name>$(P)$(R)HttpCode_RBV</pv_name>
        </rule>
      </rules>
      <border_width>1</border_width>
      <border_color>
        <color red="160" green="160" blue="160">
        </color>
      </border_color>
    </widget>
  </widget>
