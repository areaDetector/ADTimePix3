<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>TimePixDetectorHealth</name>
  <width>340</width>
  <height>505</height>
  <background_color>
    <color red="187" green="187" blue="187">
    </color>
  </background_color>
  <grid_step_x>5</grid_step_x>
  <grid_step_y>5</grid_step_y>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>Detector health — $(P)$(R)</text>
    <x>5</x>
    <y>5</y>
    <width>330</width>
    <height>22</height>
    <font>
      <font family="Sans" style="BOLD" size="12.0">
      </font>
    </font>
    <foreground_color>
      <color red="10" green="0" blue="184">
      </color>
    </foreground_color>
    <background_color>
      <color red="220" green="235" blue="255">
      </color>
    </background_color>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="group" version="3.0.0">
    <name>EnvironmentGroup</name>
    <x>5</x>
    <y>30</y>
    <width>330</width>
    <height>130</height>
    <widget type="label" version="2.0.0">
      <name>EnvironmentTitle</name>
      <text>Environment</text>
      <x>5</x>
      <y>2</y>
      <width>120</width>
      <background_color>
        <color red="240" green="240" blue="240">
        </color>
      </background_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>LocalTempLbl</name>
      <text>LocalTemp</text>
      <x>5</x>
      <y>28</y>
      <width>80</width>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>LocalTempRBV</name>
      <pv_name>$(P)$(R)LocalTemp_RBV</pv_name>
      <x>90</x>
      <y>26</y>
      <width>200</width>
      <height>22</height>
      <format>1</format>
      <precision>3</precision>
    </widget>
    <widget type="label" version="2.0.0">
      <name>FPGATempLbl</name>
      <text>FPGATemp</text>
      <x>5</x>
      <y>53</y>
      <width>80</width>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>FPGATempRBV</name>
      <pv_name>$(P)$(R)FPGATemp_RBV</pv_name>
      <x>90</x>
      <y>51</y>
      <width>200</width>
      <height>22</height>
      <format>1</format>
      <precision>3</precision>
    </widget>
    <widget type="label" version="2.0.0">
      <name>HumidityLbl</name>
      <text>Humidity</text>
      <x>5</x>
      <y>78</y>
      <width>80</width>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>HumidityRBV</name>
      <pv_name>$(P)$(R)Humidity_RBV</pv_name>
      <x>90</x>
      <y>76</y>
      <width>200</width>
      <height>22</height>
      <precision>3</precision>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>CoolingGroup</name>
    <x>5</x>
    <y>165</y>
    <width>330</width>
    <height>105</height>
    <widget type="label" version="2.0.0">
      <name>CoolingTitle</name>
      <text>Cooling</text>
      <x>5</x>
      <y>2</y>
      <width>120</width>
      <background_color>
        <color red="240" green="240" blue="240">
        </color>
      </background_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Fan1SpeedLbl</name>
      <text>Fan1Speed</text>
      <x>5</x>
      <y>28</y>
      <width>80</width>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Fan1SpeedRBV</name>
      <pv_name>$(P)$(R)Fan1Speed_RBV</pv_name>
      <x>90</x>
      <y>26</y>
      <width>200</width>
      <height>22</height>
      <format>1</format>
      <precision>3</precision>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Fan2SpeedLbl</name>
      <text>Fan2Speed</text>
      <x>5</x>
      <y>53</y>
      <width>80</width>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Fan2SpeedRBV</name>
      <pv_name>$(P)$(R)Fan2Speed_RBV</pv_name>
      <x>90</x>
      <y>51</y>
      <width>200</width>
      <height>22</height>
      <format>1</format>
      <precision>3</precision>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>DetectorRailsGroup</name>
    <x>5</x>
    <y>275</y>
    <width>330</width>
    <height>155</height>
    <widget type="label" version="2.0.0">
      <name>DetectorRailsTitle</name>
      <text>Bias and power rails</text>
      <x>5</x>
      <y>2</y>
      <width>160</width>
      <background_color>
        <color red="240" green="240" blue="240">
        </color>
      </background_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>BiasVoltageLbl</name>
      <text>BiasVoltage</text>
      <x>5</x>
      <y>28</y>
      <width>80</width>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>BiasVoltageRBV</name>
      <pv_name>$(P)$(R)BiasVoltage_RBV</pv_name>
      <x>90</x>
      <y>26</y>
      <width>200</width>
      <height>22</height>
      <format>1</format>
      <precision>7</precision>
    </widget>
    <widget type="label" version="2.0.0">
      <name>ChipTempsLbl</name>
      <text>ChipTemps</text>
      <x>5</x>
      <y>53</y>
      <width>80</width>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>ChipTempsRBV</name>
      <pv_name>$(P)$(R)ChipTemps_RBV</pv_name>
      <x>90</x>
      <y>51</y>
      <width>200</width>
      <height>22</height>
      <format>6</format>
    </widget>
    <widget type="label" version="2.0.0">
      <name>VDDLbl</name>
      <text>VDD</text>
      <x>5</x>
      <y>78</y>
      <width>80</width>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>VDDRBV</name>
      <pv_name>$(P)$(R)VDD_RBV</pv_name>
      <x>90</x>
      <y>76</y>
      <width>200</width>
      <height>22</height>
      <format>6</format>
    </widget>
    <widget type="label" version="2.0.0">
      <name>AVDDLbl</name>
      <text>AVDD</text>
      <x>5</x>
      <y>103</y>
      <width>80</width>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>AVDDRBV</name>
      <pv_name>$(P)$(R)AVDD_RBV</pv_name>
      <x>90</x>
      <y>101</y>
      <width>200</width>
      <height>22</height>
      <format>6</format>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>ActionsGroup</name>
    <x>5</x>
    <y>435</y>
    <width>330</width>
    <height>65</height>
    <widget type="label" version="2.0.0">
      <name>ActionsTitle</name>
      <text>Related</text>
      <x>5</x>
      <y>2</y>
      <width>120</width>
      <background_color>
        <color red="240" green="240" blue="240">
        </color>
      </background_color>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>PowerVoltagesBtn</name>
      <actions>
        <action type="open_display">
          <description>Power voltages</description>
          <file>TimePixDetectorVoltages.bob</file>
          <target>tab</target>
        </action>
      </actions>
      <text>Power voltages</text>
      <x>80</x>
      <y>5</y>
      <width>120</width>
      <height>26</height>
      <background_color>
        <color red="115" green="223" blue="255">
        </color>
      </background_color>
      <tooltip>Open detailed power-rail monitor</tooltip>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>RefreshBtn</name>
      <actions>
        <action type="write_pv">
          <description>Refresh health from Serval</description>
          <pv_name>$(P)$(R)Health</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>Refresh</text>
      <x>220</x>
      <y>5</y>
      <width>75</width>
      <height>26</height>
      <background_color>
        <color red="115" green="223" blue="255">
        </color>
      </background_color>
      <tooltip>Pulse Health=1 to read back detector health from Serval</tooltip>
    </widget>
  </widget>
</display>
