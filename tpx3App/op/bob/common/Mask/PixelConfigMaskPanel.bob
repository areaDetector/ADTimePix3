<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>PixelConfig vs BPC</name>
  <width>750</width>
  <height>920</height>
  <background_color>
    <color red="240" green="240" blue="240">
    </color>
  </background_color>
  <grid_step_x>5</grid_step_x>
  <grid_step_y>5</grid_step_y>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>SERVAL PixelConfig vs disk BPC</text>
    <x>5</x>
    <y>5</y>
    <width>400</width>
    <height>22</height>
    <font>
      <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color red="0" green="0" blue="180">
      </color>
    </foreground_color>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <actions>
    </actions>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Hint</name>
    <text>Use Verify BPC on the BPC/DACS screen to update the packed-pixel |SERVAL − BPC| heatmap and write *_masked_pels.json (see block below).</text>
    <x>5</x>
    <y>32</y>
    <width>650</width>
    <height>36</height>
    <foreground_color>
      <color red="60" green="60" blue="60">
      </color>
    </foreground_color>
    <actions>
    </actions>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>VerifyBPCBtn</name>
    <actions>
      <action type="write_pv">
        <description>Verify BPC</description>
        <pv_name>$(P)$(R)RefreshPixelConfig</pv_name>
        <value>1</value>
      </action>
    </actions>
    <text>Verify BPC</text>
    <x>420</x>
    <y>3</y>
    <width>95</width>
    <height>24</height>
    <background_color>
      <color red="120" green="200" blue="255">
      </color>
    </background_color>
    <tooltip>Read Serval PixelConfig, decode it, and compare it with the selected BPC file.</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>BPCDACSBtn</name>
    <actions>
      <action type="open_display">
        <description>BPC and DACS setup</description>
        <file>../Setup/FileBPCdacs.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>BPC / DACS...</text>
    <x>520</x>
    <y>3</y>
    <width>120</width>
    <height>24</height>
    <background_color>
      <color red="120" green="200" blue="255">
      </color>
    </background_color>
    <tooltip>Open BPC/DACS setup to upload or verify the selected BPC file.</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>L0</name>
    <text>CHIP0</text>
    <x>5</x>
    <y>72</y>
    <width>50</width>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <actions>
    </actions>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>CH0Len</name>
    <pv_name>$(P)$(R)CHIP0_PixelConfigLen_RBV</pv_name>
    <x>60</x>
    <y>70</y>
    <width>72</width>
    <height>22</height>
    <vertical_alignment>1</vertical_alignment>
    <actions>
    </actions>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>CH0Match</name>
    <pv_name>$(P)$(R)CHIP0_PixelConfigMatchBPC_RBV</pv_name>
    <x>140</x>
    <y>70</y>
    <width>40</width>
    <height>22</height>
    <vertical_alignment>1</vertical_alignment>
    <actions>
    </actions>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>CH0Stat</name>
    <pv_name>$(P)$(R)CHIP0_PixelConfigStatus_RBV</pv_name>
    <x>188</x>
    <y>70</y>
    <width>500</width>
    <height>22</height>
    <format>6</format>
    <vertical_alignment>1</vertical_alignment>
    <actions>
    </actions>
  </widget>
  <widget type="label" version="2.0.0">
    <name>L1</name>
    <text>CHIP1</text>
    <x>5</x>
    <y>96</y>
    <width>50</width>
    <visible>false</visible>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <actions>
    </actions>
    <rules>
      <rule name="Vis2plusChips" prop_id="visible" out_exp="false">
        <exp bool_exp="pv0==262144">
          <value>true</value>
        </exp>
        <exp bool_exp="pv0==524288">
          <value>true</value>
        </exp>
        <pv_name>$(P)$(R)PixCount_RBV</pv_name>
      </rule>
    </rules>
  </widget>
