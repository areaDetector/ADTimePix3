        <exp bool_exp="pvInt0==262144"><expression>512</expression></exp>
        <exp bool_exp="pvInt0==524288"><expression>1024</expression></exp>
        <pv_name>$(P)$(R)PixCount_RBV</pv_name>
      </rule>
      <rule name="Image height" prop_id="data_height" out_exp="true">
        <exp bool_exp="pvInt0==65536"><expression>256</expression></exp>
        <exp bool_exp="pvInt0==262144 || pvInt0==524288"><expression>512</expression></exp>
        <pv_name>$(P)$(R)PixCount_RBV</pv_name>
      </rule>
      <rule name="X axis maximum" prop_id="x_axis.maximum" out_exp="true">
        <exp bool_exp="pvInt0==65536"><expression>256</expression></exp>
        <exp bool_exp="pvInt0==262144"><expression>512</expression></exp>
        <exp bool_exp="pvInt0==524288"><expression>1024</expression></exp>
        <pv_name>$(P)$(R)PixCount_RBV</pv_name>
      </rule>
      <rule name="Y axis minimum" prop_id="y_axis.minimum" out_exp="true">
        <exp bool_exp="pvInt0==65536"><expression>256</expression></exp>
        <exp bool_exp="pvInt0==262144 || pvInt0==524288"><expression>512</expression></exp>
        <pv_name>$(P)$(R)PixCount_RBV</pv_name>
      </rule>
      <rule name="Widget width" prop_id="width" out_exp="true">
