        <exp bool_exp="pvInt0==262144"><expression>512</expression></exp>
        <exp bool_exp="pvInt0==524288"><expression>350</expression></exp>
        <pv_name>$(P)$(R)PixCount_RBV</pv_name>
      </rule>
    </rules>
    <border_alarm_sensitive>false</border_alarm_sensitive>
