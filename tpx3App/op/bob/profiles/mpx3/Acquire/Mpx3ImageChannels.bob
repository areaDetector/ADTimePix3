      <y>4</y>
      <width>900</width>
      <height>18</height>
      <font>
        <font family="Sans" style="BOLD" size="11.0">
        </font>
      </font>
      <foreground_color>
        <color red="10" green="0" blue="184">
        </color>
      </foreground_color>
    </widget>
