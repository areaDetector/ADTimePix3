      <height>22</height>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>WriteDataBtn</name>
      <actions>
        <action type="write_pv">
          <description>Push destination to Serval</description>
          <pv_name>$(P)$(R)WriteData</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>WriteData</text>
      <x>115</x>
      <y>26</y>
      <width>85</width>
      <height>26</height>
